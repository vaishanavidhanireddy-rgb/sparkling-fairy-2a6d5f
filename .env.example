# Flask Configuration
SECRET_KEY=your-long-random-secret

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# API Keys
MISTRAL_API_KEY=mstrl_your-mistral-key
GROQ_API_KEY=gsk_your-groq-key
GEMINI_API_KEY=AQ.your-gemini-key

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Mail Settings (disabled for Supabase auth)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=0
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_DEFAULT_SENDER=""
MAIL_VERIFICATION_ENABLED=0
MAIL_OTP_ENABLED=0

# Firebase (if using Google sign-in)
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=your-web-app-id
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_FILE=path/to/service-account.json

# Hospital Admin Emails (comma-separated)
HOSPITAL_ADMIN_EMAILS=

# Public Base URL (set this for Render/Vercel deployment)
PUBLIC_BASE_URL=https://your-render-app.onrender.com

# Cookie Security (set to 1 for HTTPS in production)
COOKIE_SECURE=0